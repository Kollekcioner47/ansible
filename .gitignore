# Что не попадает в репозиторий курса.
#
# Смысл файла не в том, чтобы «было чисто», а в том, чтобы учебные
# ключи, пароли Vault и результаты прогонов не уехали вместе
# с материалами. В курсе есть практики про секреты, про подключение
# по ключу и про разметку диска: студент создаёт пароль Vault,
# SSH-ключ, файл инвентаря с рабочими адресами. Всё это — его,
# а не курса.

# Пароль Ansible Vault (практика 5). В репозитории его быть не должно:
# именно на этом строится вся практика про секреты.
.vault_pass
.vault_pass.*
vault-pass*
*.vault-password

# Зашифрованные файлы переменных с рабочими секретами.
# Образцы учебных файлов лежат в files/ и версионируются.
*secret*.yml
!files/**

# SSH-ключи и сертификаты: практика 1 создаёт ключ ed25519 на стенде,
# а не хранит его в курсе.
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.key
*.pem
*.crt
*.p12
.ssh/

# Виртуальное окружение Python, в которое ставится ansible-core
# (практика 1). Весит сотни мегабайт и у каждого своё.
.venv/
venv/
ansible-venv/
env/

# Роли и коллекции, установленные из Galaxy (практика 15):
# их получают командой ansible-galaxy install.
collections/
.galaxy/
galaxy_cache/
*.tar.gz.requirements

# Кэш фактов, кэш инвентаря и служебные каталоги Ansible.
.ansible/
ansible_facts_cache/
*.retry
.cache/

# Состояние и артефакты molecule (практика 16): создаётся при прогоне,
# в репозитории ему делать нечего.
.molecule/
molecule/*/.molecule/
molecule/*/state.yml
__pycache__/
*.pyc
.pytest_cache/
.ansible-lint-cache/
*.sarif

# Резервные копии файлов, которые делает модуль copy с backup: true,
# и каталог резервных копий из практики 8.
backup/
*.bak
*.orig
*~

# Архивы, которые практика 8 создаёт и распаковывает.
*.tgz
*.tar
*.tar.bz2
*.zip

# Журналы и отчёты прогонов: удобно держать рядом с практикой,
# незачем версионировать.
*.log
*.out
report-*.txt

# Локальные файлы инвентаря с рабочими адресами.
# Учебный инвентарь лежит в files/02_inventory/ и версионируется.
inventory.local.ini
hosts.prod
