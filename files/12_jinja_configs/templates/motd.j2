{#- Шаблон /etc/motd. Собирается на каждой машине группы linux. -#}
{{ ansible_managed }}
=========================================================================
  {{ inventory_hostname | upper }} — учебный стенд курса Ansible
  {{ ansible_facts['distribution'] }} {{ ansible_facts['distribution_version'] }} ({{ ansible_facts['os_family'] }})
=========================================================================

Машина:      {{ inventory_hostname }} ({{ ansible_facts['default_ipv4']['address'] }})
Ядер:        {{ ansible_facts['processor_vcpus'] }}
Память, МБ:  {{ ansible_facts['memtotal_mb'] }}
Группы:      {{ group_names | sort | join(', ') }}

Адреса машин группы linux:
{% for host in groups['linux'] %}
{% set address = hostvars[host]['ansible_facts']['default_ipv4']['address'] | default('адрес неизвестен') %}
{% set family = hostvars[host]['ansible_facts']['os_family'] | default('семейство неизвестно') %}
  {{ '%-6s' | format(host) }} {{ '%-16s' | format(address) }} {{ family }}
{% endfor %}
Всего машин: {{ groups['linux'] | length }} ({% for host in groups['linux'] %}{{ host }}{{ ', ' if not loop.last else '' }}{% endfor %})
Владелец:    {{ ansible_facts['ansible_local']['site']['general']['owner'] | default('не назначен') }}
{% if motd_notice is defined %}

Объявление:
{{ motd_notice }}
{% endif %}
