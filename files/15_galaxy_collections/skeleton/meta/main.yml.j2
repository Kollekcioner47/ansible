# meta/main.yml.j2 — шаблон описания роли для своего скелета.
#
# Файлы с расширением .j2 в скелете рендерит Jinja2, а само
# расширение отбрасывается: этот файл станет meta/main.yml.
# Переменные (role_name, author, license и другие) подставляет
# ansible-galaxy role init.
#
# Строковые значения взяты в кавычки: описание роли вполне может
# содержать двоеточие с пробелом, а без кавычек YAML на этом
# ломается.
---
galaxy_info:
  role_name: "{{ role_name }}"
  author: "{{ author }}"
  description: "{{ description }}"
  company: "{{ company }}"
  license: "{{ license }}"
  min_ansible_version: "{{ min_ansible_version }}"

  platforms:
    - name: Ubuntu
      versions:
        - all
    - name: EL
      versions:
        - all

  galaxy_tags:
    - lab

dependencies: []
